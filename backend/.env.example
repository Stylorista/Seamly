# Optional approved product feed. Keep marketplace credentials in the feed
# service or backend environment; never compile them into the Flutter app.
FASHIONTECH_SHOP_CATALOG_URL=https://catalog.your-domain.example/fashiontech.json
FASHIONTECH_SHOP_CATALOG_TOKEN=replace-with-a-secret-bearer-token

# Google Sign-In: comma-separated OAuth Web client IDs allowed to sign in.
# Get one from Google Cloud Console > APIs & Services > Credentials.
# Set the same value as GOOGLE_WEB_CLIENT_ID in the Flutter build.
GOOGLE_CLIENT_IDS=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# For local testing only, the same normalized payload can be supplied inline.
# FASHIONTECH_SHOP_CATALOG_JSON={"items":[]}
